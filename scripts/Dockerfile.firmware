FROM logronoide/atarist-toolkit-docker-x86_64@sha256:5065daced2efd388c6b7b154938cc884748d39111bc2f2571dc0e63814949bce
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cmake ninja-build gcc-arm-none-eabi libnewlib-arm-none-eabi libstdc++-arm-none-eabi-newlib ca-certificates
ENTRYPOINT ["/bin/bash"]
